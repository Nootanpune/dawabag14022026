# Dawabag PRODUCTION settings — the whole file goes into the GitHub ENVIRONMENT secret
# PRODUCTION_ENV (Settings → Environments → production → Environment secrets) and into the
# owner's password manager. Nowhere else: never commit a filled copy, never e-mail it.
#
# Do not fill the secrets by hand: deploy/production/make-production-env.sh prints this file
# with every secret freshly generated. Then fill the blanks marked FILL IN (third-party keys)
# and check it:  deploy/production/check-env.sh <file>   (the deploy workflow checks it again).
# The deploy workflow writes it to the server as deploy/production/production.env (mode 600).
# Placeholders (__…__ and change-me) make the check and the API refuse to start.

# ── The deployment ───────────────────────────────────────────────────────────────────────
# Forced to production by deploy/production/compose.production.yml as well
APP_ENV=production
# This deployment's own background job queues in Redis (Sprint 47)
QUEUE_PREFIX=dawabag-production

# ── Addresses (point DNS at the server first — docs/PRODUCTION.md "DNS") ────────────────
WEB_DOMAIN=__WEB_DOMAIN__
API_DOMAIN=__API_DOMAIN__
# The bare domain; Caddy redirects it to WEB_DOMAIN. Leave empty if it must not point here.
APEX_DOMAIN=__APEX_DOMAIN__
# Let's Encrypt certificate notices
ACME_EMAIL=__ACME_EMAIL__

# ── Secrets generated by make-production-env.sh (keep stable; see the warnings it prints) ─
# The database owner (migrations, backups); the API never sees it
DB_PASSWORD=change-me-run-make-production-env
# The API's own restricted database login (Sprint 41; member of dawabag_app only)
DB_APP_PASSWORD=change-me-run-make-production-env
JWT_ACCESS_SECRET=change-me-run-make-production-env
JWT_REFRESH_SECRET=change-me-run-make-production-env
# Two-step sign-in secrets (Sprint 42). LOSING IT: every enrolled authenticator stops working.
TOTP_ENC_KEY=change-me-run-make-production-env
# Health details at rest (Sprint 43). LOSING IT: buyers' health details are unreadable.
HEALTH_ENC_KEY=change-me-run-make-production-env
# 5-minute document links and delivery codes (Sprint 5–6); changing them breaks codes in flight
DOCUMENT_LINK_SECRET=change-me-run-make-production-env
HANDOVER_CODE_SECRET=change-me-run-make-production-env
# Shiprocket webhook token: paste the same value in Shiprocket → Settings → API → Webhooks
SHIPROCKET_WEBHOOK_TOKEN=change-me-run-make-production-env
# Client-side encryption of every database backup (Sprint 50). LOSING IT: every backup
# made with it is unreadable — including the 8-year monthly copies (C-34).
BACKUP_ENC_KEY=change-me-run-make-production-env

# ── Documents and e-mail: AWS, Mumbai (ap-south-1 — required, C-44) ─────────────────────
AWS_REGION=ap-south-1
# FILL IN: an IAM user for the API only — S3 on the documents bucket + SES send (docs/PRODUCTION.md)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# FILL IN: the documents bucket (private, versioned, default encryption on), e.g. dawabag-documents-prod
AWS_S3_BUCKET=
# FILL IN: a verified SES sender, e.g. noreply@<your domain> (SES out of sandbox: checklist 3.3)
AWS_SES_FROM_EMAIL=

# ── Backups: a SEPARATE bucket in a second Indian region (offsite), backup-only keys ────
# FILL IN: e.g. dawabag-backups-prod in ap-south-2 (Hyderabad); lifecycle rule from
# deploy/staging/backup-lifecycle.json (daily 35 days, monthly 8 years)
BACKUP_S3_BUCKET=
BACKUP_AWS_REGION=ap-south-2
# FILL IN: an IAM user that may only put / get / list (no delete) in that bucket
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_SSE=AES256
BACKUP_AT=02:30

# ── Payments: Razorpay LIVE keys (rzp_live_…) — docs/PRODUCTION.md "Razorpay live" ──────
# FILL IN. Test keys (rzp_test_…) are refused unless PAYMENTS_TEST_MODE=true (dry-run day only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# PAYMENTS_TEST_MODE=true

# ── SMS: MSG91 with DLT templates (required: sign-in codes) ─────────────────────────────
# FILL IN
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_OTP=
# Optional: WhatsApp business number (digits with country code)
MSG91_WHATSAPP_NUMBER=

# ── Optional integrations (the API starts without them and logs what is off) ───────────
# FILL IN when ready. Push: Firebase service-account JSON as ONE line of base64
FCM_SERVICE_ACCOUNT_JSON=
# Courier: a Shiprocket API user
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Video consultations: Agora (both, or neither)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# E-invoicing (IRP) — all six, or none; whitelist the server's IP on the IRP portal
IRP_BASE_URL=
IRP_CLIENT_ID=
IRP_CLIENT_SECRET=
IRP_USERNAME=
IRP_PASSWORD=
IRP_PUBLIC_KEY=
