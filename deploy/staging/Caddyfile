# Dawabag staging front door. Certificates come from Let's Encrypt automatically once
# DNS points here; CADDY_GLOBAL_OPTIONS=local_certs uses Caddy's own CA (CI, tests).
{
	{$CADDY_GLOBAL_OPTIONS}
	email {$ACME_EMAIL:admin@localhost}
}

(common) {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Sprint 50: browser features neither the shop nor the API uses are switched off
		# (camera and microphone stay allowed for the site itself: video consultations, C-23)
		Permissions-Policy "geolocation=(), usb=(), serial=(), bluetooth=(), magnetometer=(), gyroscope=(), accelerometer=(), browsing-topics=()"
		-Server
	}
	# Access logs never carry an e-prescription check code (it opens the prescription);
	# the API's own log redacts it the same way. Cookies and Authorization are redacted
	# by Caddy itself (C-41, C-43)
	log {
		output stdout
		format filter {
			request>uri regexp (/eprescriptions/verify/)[^/?]+ ${1}[code]
		}
	}
}

{$WEB_DOMAIN} {
	import common
	# No other site may frame the shop (clickjacking of checkout, admin and portals)
	header {
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
	}
	reverse_proxy web:3000
}

{$API_DOMAIN} {
	import common
	# Large enough for prescription and KYC uploads (the API checks its own limits)
	request_body {
		max_size 12MB
	}
	reverse_proxy api:4000
}

# Sprint 50: names that only send visitors to the website (production: the bare domain,
# REDIRECT_DOMAINS=dawabag.com → https://www.dawabag.com), with their own certificates.
# Without it the name is a harmless plain-HTTP placeholder nothing points at.
{$REDIRECT_DOMAINS} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	redir https://{$WEB_DOMAIN}{uri} permanent
}

# The server's own object store (trial: compose profile objectstore). Browsers reach it
# only here, only to read, and only with a signed, short-lived link from the API (product
# photos, a prescription a pharmacist opens — C-41). Signatures are cut from the access
# log so a logged link cannot be replayed. Without the profile this name points nowhere.
{$FILES_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	log {
		output stdout
		format filter {
			request>uri query {
				delete X-Amz-Signature
				delete X-Amz-Credential
			}
		}
	}
	@write not method GET HEAD
	respond @write "Read only" 405
	@unsigned not query X-Amz-Signature=*
	respond @unsigned "Signed links only" 403
	# Caddy passes the Host header through unchanged, so the store checks the
	# signature against the same public address the API signed for
	reverse_proxy objectstore:9000
}
