# Dawabag staging settings — copy to staging.env on the server (never commit staging.env).
# Same keys as backend/.env.example; the stack sets the database, Redis, CORS and proxy
# values itself. Test-mode keys only (Razorpay rzp_test_…, MSG91 test sender).

WEB_DOMAIN=staging.dawabag.in
API_DOMAIN=api-staging.dawabag.in
ACME_EMAIL=tech@dawabag.in

DB_PASSWORD=change-me-long-random
JWT_ACCESS_SECRET=change-me-at-least-32-random-characters
JWT_REFRESH_SECRET=change-me-a-different-32-random-characters

# Staging may run before every integration is ready; the API then warns instead of
# refusing to start, and the missing feature is switched off.
ALLOW_MISSING_INTEGRATIONS=true
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID= AWS_SECRET_ACCESS_KEY= AWS_S3_BUCKET= AWS_SES_FROM_EMAIL=
# RAZORPAY_KEY_ID= RAZORPAY_KEY_SECRET= RAZORPAY_WEBHOOK_SECRET=
# MSG91_AUTH_KEY= MSG91_SENDER_ID= MSG91_TEMPLATE_OTP=
# AGORA_APP_ID= AGORA_APP_CERTIFICATE=
# S3_ENDPOINT=   # S3-compatible store instead of AWS S3 (path-style URL); staging only
# S3_PUBLIC_ENDPOINT=  # that store's public https address for signed links (compose
#                      # profile objectstore + FILES_DOMAIN; see deploy/trial/trial.env.example)
# APP_ENV=staging      # 'trial' only for the owner's demo server (deploy/trial/TRIAL.md)

# Nightly database backups (the `backup` service; RUNBOOK 7c). The dump streams straight
# to the object store — never to this server's disk — with server-side encryption (C-41).
# Prefer a separate bucket with its own keys that may only write/read/list backups/ in it
# (versioning on, public access blocked, the lifecycle rule in backup-lifecycle.json:
# daily 35 days, first backup of each month 8 years — GST books, C-34, C-44).
# Leave BACKUP_S3_BUCKET empty to use AWS_S3_BUCKET above; leave both empty and backups
# are OFF (the service logs it, check.sh skips the backup-age check).
# BACKUP_S3_BUCKET=dawabag-staging-backups
# BACKUP_S3_ENDPOINT=                 # S3-compatible store for backups (else S3_ENDPOINT)
# BACKUP_AWS_ACCESS_KEY_ID=           # backup-only keys (else AWS_ACCESS_KEY_ID / _SECRET_)
# BACKUP_AWS_SECRET_ACCESS_KEY=
# BACKUP_SSE=AES256                   # or aws:kms (+ BACKUP_KMS_KEY_ID), or none if the store rejects it
# BACKUP_AT=02:30                     # daily, Asia/Kolkata time (HH:MM)
# BACKUP_PRUNE=false                  # true only when the store has no lifecycle rules
