# Dawabag TRIAL server settings — the whole file goes into the GitHub secret TRIAL_ENV.
# Do not fill this by hand: deploy/trial/make-trial-env.sh <server-ip> <email> prints it
# with the names and fresh random secrets filled in (bootstrap-server.sh --email does too).
# The deploy workflow writes it to the server as deploy/staging/staging.env; never commit
# a filled copy. Until generated, the change-me values make the API refuse to start.

# A trial: demo data, placeholder licences, Razorpay TEST keys only, the server's own
# object store. Production (APP_ENV=production) refuses every trial-only setting below.
APP_ENV=trial
ALLOW_MISSING_INTEGRATIONS=true

# Addresses (sslip.io names point at the server's IP; or your own domain)
WEB_DOMAIN=__BASE__
API_DOMAIN=api.__BASE__
FILES_DOMAIN=files.__BASE__
ACME_EMAIL=change-me@example.com

DB_PASSWORD=change-me-run-make-trial-env
JWT_ACCESS_SECRET=change-me-run-make-trial-env-access-secret
JWT_REFRESH_SECRET=change-me-run-make-trial-env-refresh-secret
AWS_REGION=ap-south-1

# The server's own object store (compose profile objectstore): product photos,
# prescriptions, KYC files and the nightly database backups. Data stays in a Docker
# volume on this server, encrypted with OBJECTSTORE_KMS_KEY; browsers get signed links
# through https://FILES_DOMAIN only.
S3_ENDPOINT=http://objectstore:9000
S3_PUBLIC_ENDPOINT=https://files.__BASE__
AWS_S3_BUCKET=dawabag-trial
AWS_ACCESS_KEY_ID=dawabag-trial
AWS_SECRET_ACCESS_KEY=change-me-run-make-trial-env
OBJECTSTORE_KMS_KEY=change-me-run-make-trial-env
# Backups go to the same store (no lifecycle rules there, so the script prunes)
BACKUP_PRUNE=true

# One password for every demo login (printed by make-trial-env.sh, never by the seed)
TRIAL_DEMO_PASSWORD=change-me-run-make-trial-env

# Razorpay TEST mode keys (dashboard → Test mode → Account & Settings → API keys;
# webhook https://api.__BASE__/api/v1/payments/webhook). Live keys are refused in a trial.
# Without them checkout stops at the payment step.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Not used in the trial: SMS (MSG91 — new sign-ups need it), e-mail (SES), push (FCM),
# courier, e-invoicing, video calls (Agora). Leave empty; the API logs them as off.
