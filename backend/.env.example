# ─── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ─── Database (PostgreSQL) ─────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dawabag
DB_USER=dawabag_user
DB_PASSWORD=your_strong_password_here
DB_POOL_MAX=20
DB_SSL=false

# ─── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ───────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_random_64_char_string
JWT_REFRESH_SECRET=change_this_to_another_random_64_char_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── AWS ───────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=dawabag-prescriptions-prod
AWS_SES_FROM_EMAIL=noreply@dawabag.in

# ─── Razorpay ──────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
# Dashboard → Webhooks: URL https://<api-domain>/api/v1/payments/webhook, events payment.*, refund.*
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── SMS (MSG91) ───────────────────────────────────────
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=DAWABG
MSG91_TEMPLATE_OTP=your_otp_template_id
# Other message types use DLT templates set in Admin → Settings → sms.dlt_templates

# ─── FCM (Firebase Push, HTTP v1) ──────────────────────
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the JSON on one line, or its base64. Never commit it.
FCM_SERVICE_ACCOUNT_JSON=

# ─── Agora (Video Consultation) ────────────────────────
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_certificate

# ─── Shiprocket (Courier) ──────────────────────────────
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password
# Shiprocket → Settings → API → Webhooks: URL https://<api-domain>/api/v1/courier/shiprocket/webhook,
# security token = this value (openssl rand -hex 24). Booking is on when Admin → Settings → courier.provider = shiprocket.
SHIPROCKET_WEBHOOK_TOKEN=

# ─── GST e-invoicing (IRP) ─────────────────────────────
# From your IRP (NIC einvoice1.gst.gov.in or a private IRP such as IRIS) after API
# registration: base URL, API client id/secret, API user and password, and the IRP's
# public key (PEM or base64 DER). Seller GSTIN comes from Admin → Settings → legal entity.
# Sandbox: https://einv-apisandbox.nic.in. Switch on with Admin → Settings → einvoice.enabled.
IRP_BASE_URL=
IRP_CLIENT_ID=
IRP_CLIENT_SECRET=
IRP_USERNAME=
IRP_PASSWORD=
IRP_PUBLIC_KEY=

# ─── Behind a load balancer: how many proxy hops to trust for the client IP ───
TRUST_PROXY_HOPS=1
# Public e-prescription checks per IP per 15 minutes
VERIFY_RATE_LIMIT_MAX=30

# ─── Public website address (printed on e-prescriptions for the check link) ───
PUBLIC_WEB_URL=https://dawabag.in

# ─── Provider addresses (tests only; leave unset in production) ───
# MSG91_BASE_URL= GOOGLE_OAUTH_TOKEN_URL= FCM_BASE_URL= SHIPROCKET_BASE_URL= RAZORPAY_BASE_URL=

# ─── App Config ────────────────────────────────────────
BCRYPT_ROUNDS=12
OTP_EXPIRY_MINUTES=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
WELCOME_COUPON_CODE=WELCOME10
WELCOME_COUPON_DISCOUNT=10

# ─── Sprint 1 ───────────────────────────────────────────────────────────────
# Documents go only to S3 (AWS_S3_BUCKET above); no local storage.
# Optional S3-compatible endpoint for a staging object store:
# S3_ENDPOINT=https://s3.staging.example.com
# Stored with every consent record; bump when the privacy notice text changes
PRIVACY_POLICY_VERSION=2026-10-v1
# Requests per 15 minutes per IP
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
# Browser origins allowed to call the API with the session cookie (comma-separated)
CORS_ORIGINS=http://localhost:3000
# Web session cookie: Secure by default; COOKIE_DOMAIN e.g. .dawabag.in in production
# COOKIE_DOMAIN=.dawabag.in

# ─── Sprint 5–6 ──────────────────────────────────────────────────────────────
# Secrets for 5-minute document links and the delivery code (default: JWT_ACCESS_SECRET)
# DOCUMENT_LINK_SECRET=random_64_chars
# HANDOVER_CODE_SECRET=random_64_chars
# Production refuses to start without Razorpay, S3, MSG91 and SES keys; set this
# only for a closed staging environment
# ALLOW_MISSING_INTEGRATIONS=true
# Run scheduled jobs on exactly one kind of instance if you split roles (a Redis
# lock already stops double runs)
# DISABLE_SCHEDULER=false
# The container applies pending migrations on start; set false to run them separately
# RUN_MIGRATIONS=true
