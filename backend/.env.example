# ─── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ─── Database (PostgreSQL) ─────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dawabag
DB_USER=dawabag_user
DB_PASSWORD=your_strong_password_here
DB_POOL_MAX=20
DB_SSL=false

# ─── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ───────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_random_64_char_string
JWT_REFRESH_SECRET=change_this_to_another_random_64_char_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── AWS ───────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=dawabag-prescriptions-prod
AWS_SES_FROM_EMAIL=noreply@dawabag.in

# ─── Razorpay ──────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─── SMS (MSG91) ───────────────────────────────────────
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=DAWABG
MSG91_TEMPLATE_OTP=your_otp_template_id

# ─── FCM (Firebase Push) ───────────────────────────────
FCM_SERVER_KEY=your_firebase_server_key

# ─── Agora (Video Consultation) ────────────────────────
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_certificate

# ─── Shiprocket (Courier) ──────────────────────────────
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password

# ─── App Config ────────────────────────────────────────
BCRYPT_ROUNDS=12
OTP_EXPIRY_MINUTES=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
WELCOME_COUPON_CODE=WELCOME10
WELCOME_COUPON_DISCOUNT=10
